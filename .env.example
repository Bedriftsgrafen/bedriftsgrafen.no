# Application Settings
APP_NAME=bedriftsgrafen.no
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Site Base URL (optional - defaults to https://bedriftsgrafen.no)
# Override for staging environments or local development with custom domain
# BASE_URL=https://staging.bedriftsgrafen.no
# Frontend canonical/OG site URL and site name (optional - defaults to Bedriftsgrafen)
# VITE_SITE_URL=https://bedriftsgrafen.no
# VITE_SITE_NAME=Bedriftsgrafen.no

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Environment (development, staging, production)
ENVIRONMENT=development

# Admin API Key (required in production to access /admin/* endpoints)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Observability
# METRICS_TOKEN secures /metrics for Prometheus. Generate with: openssl rand -hex 32
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin

# Database Settings
DATABASE_HOST=bedriftsgrafen-db
DATABASE_PORT=5432
DATABASE_NAME=bedriftsgrafen
# Use dedicated app user 'admin', NOT 'postgres' superuser (security best practice)
DATABASE_USER=admin
DATABASE_PASSWORD=your-database-password-here
DATABASE_URL=postgresql://admin:your-database-password-here@bedriftsgrafen-db:5432/bedriftsgrafen

# Alternative async database URL for FastAPI
DATABASE_URL_ASYNC=postgresql+asyncpg://admin:your-database-password-here@bedriftsgrafen-db:5432/bedriftsgrafen

# Database Connection Pool Settings (for production)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_STATEMENT_TIMEOUT=60000

# CORS Settings
CORS_ORIGINS=https://bedriftsgrafen.no,http://bedriftsgrafen.no
CORS_ALLOW_CREDENTIALS=True

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Settings (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=noreply@bedriftsgrafen.no

# Redis (caching and rate limiting)
REDIS_HOST=bedriftsgrafen-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password-here
# Bound connection establishment and individual Redis commands so cache/health
# fallbacks cannot wait indefinitely when Redis or the Docker network is unavailable.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

# Docker Volumes & Paths
# Path where PostgreSQL data will be stored. Defaults to ./postgres_data
POSTGRES_DATA_PATH=./postgres_data

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Import Data Directory (whitelist for admin file imports)
# Only files in this directory can be imported via /admin/import/queue/populate
IMPORT_DATA_DIR=/app/data

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# External APIs
# Brønnøysundregistrene API (Open Data)
BRONNOYSUND_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# Brreg egress guard
# BRREG_EGRESS_RATE_PER_SECOND and BRREG_EGRESS_BURST must be explicitly set
# before production Brreg traffic is allowed. No official Brreg request-rate cap
# was found in the checked official docs as of 2026-08-08.
BRREG_EGRESS_GUARD_ENABLED=true
BRREG_EGRESS_RATE_PER_SECOND=5
BRREG_EGRESS_BURST=10
BRREG_EGRESS_WAIT_TIMEOUT_SECONDS=0
BRREG_EGRESS_REDIS_TIMEOUT_SECONDS=1

# Worker-only background sync shaping. docker-compose.prod.yml applies these
# to backend-worker only so public API requests still fail fast at wait_timeout=0.
WORKER_SUBUNIT_UPDATE_PAGE_SIZE=10
WORKER_BRREG_EGRESS_WAIT_TIMEOUT_SECONDS=60
WORKER_BRREG_BACKGROUND_EGRESS_RATE_PER_SECOND=4
WORKER_BRREG_BACKGROUND_EGRESS_BURST=40

# Subunit cache and single-flight
# These are Bedriftsgrafen-internal defaults, not Brreg-published limits.
# SUBUNIT_CACHE_TTL_SECONDS defaults to 7 days to match role cache behavior.
# SUBUNIT_FORCE_REFRESH_COOLDOWN_SECONDS defaults to 60 seconds to match role force-refresh cooldown.
SUBUNIT_CACHE_TTL_SECONDS=604800
SUBUNIT_FORCE_REFRESH_COOLDOWN_SECONDS=60
SUBUNIT_REFRESH_LOCK_TTL_SECONDS=120
SUBUNIT_REFRESH_LOCK_WAIT_TIMEOUT_SECONDS=30
SUBUNIT_REFRESH_LOCK_POLL_INTERVAL_SECONDS=0.1
SUBUNIT_REFRESH_LOCK_REDIS_TIMEOUT_SECONDS=1

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Affiliate Marketing (optional)
# Adtraction notifier secrets are file-based and must not be committed.
# Expected local files:
# - observability/secrets/ADTRACTION_API_KEY
# - observability/secrets/ADTRACTION_DISCORD_WEB_HOOK
ADTRACTION_NOTIFIER_ENABLED=false
ADTRACTION_ALERT_MODE=commission_events
ADTRACTION_CURRENCY=NOK
ADTRACTION_LOOKBACK_DAYS=365
ADTRACTION_MAX_DISCORD_MESSAGES=10
ADTRACTION_API_KEY_FILE=observability/secrets/ADTRACTION_API_KEY
ADTRACTION_DISCORD_WEBHOOK_FILE=observability/secrets/ADTRACTION_DISCORD_WEB_HOOK
ADTRACTION_STATE_PATH=observability/state/adtraction_notifier_state.json

# Backend-only tracking URLs for /api/v1/affiliates/* redirects.
# Do not expose these as VITE_* variables.
TJENESTETORGET_SPORINGSLENKE=
KLIKKLAAN_SPORINGSLENKE=
ZENSUM_SPORINGSLENKE=
RENTESJEKK_SPORINGSLENKE=
TJENESTETORGET_FORSIKRING_SPORINGSLENKE=
USCORE_SPORINGSLENKE=
